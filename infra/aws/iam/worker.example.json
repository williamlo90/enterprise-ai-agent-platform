{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "PLATFORM_JOURNAL_WRITER_ARN"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectTagging",
        "s3:GetObjectVersionTagging"
      ],
      "Resource": [
        "FILES_BUCKET_ARN/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "NOVA_PRO_APAC_PROFILE_ARN",
        "APPROVED_NOVA_PRO_FOUNDATION_ARNS",
        "COHERE_EMBED_SINGAPORE_ARN"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "bedrock:GetAccountDataRetention",
        "bedrock:GetModelInvocationLoggingConfiguration"
      ],
      "Resource": "*"
    }
  ]
}
