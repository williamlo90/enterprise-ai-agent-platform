# Dedicated restricted runtime login, service migration0003 required.
REIMBURSEMENT_DATABASE_URL=
REIMBURSEMENT_SCHEMA=reimbursement
REIMBURSEMENT_HOST=127.0.0.1
REIMBURSEMENT_PORT=8010
REIMBURSEMENT_POOL_SIZE=2

# Opt-in real platform authority / trip catalog / package receiver.
# Provision the platform recipient credential registry and independent ingress
# dispatcher credential first. Keep both credentials distinct and private.
REIMBURSEMENT_CATALOG_ENABLED=false
REIMBURSEMENT_PLATFORM_ORIGIN=
REIMBURSEMENT_PLATFORM_CREDENTIAL=
REIMBURSEMENT_DISPATCHER_CREDENTIAL=

# FILE-02 current owner/reviewer receipt relation, explicit opt-in (no writer).
REIMBURSEMENT_CLAIM_ACCESS_ENABLED=false

# DRAFT-01 owner facts only; requires catalog + claim access. No mutation API.
REIMBURSEMENT_DRAFT_SOURCES_ENABLED=false

# ACT-01 current reviewer metadata only; requires claim access. No writer.
REIMBURSEMENT_ACTION_SOURCES_ENABLED=false

# FLOW-01 private mutation/lookup/recovery, configured signer required.
REIMBURSEMENT_WORKFLOW_ENABLED=false
REIMBURSEMENT_RECOVERY_CREDENTIAL=
REIMBURSEMENT_TERMINAL_KEY_ID=
# Private32-byte hex key; inject locally or via secret store, never commit.
REIMBURSEMENT_TERMINAL_PRIVATE_HEX=
