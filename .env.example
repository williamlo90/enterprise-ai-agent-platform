# API defaults. Database is optional until credentials are supplied locally.
# Process environment overrides this file. Copy to .env locally if desired.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# BE-02 boundary defaults (bytes and seconds); no provider credentials.
APP_MAX_REQUEST_BODY_BYTES=1048576
APP_REQUEST_BODY_TIMEOUT_SECONDS=10
# Runtime API reads DATABASE_URL only when enabled. No credentials in Git/chat.
# After migration 0003, security provision saves a verified restricted login here.
# An owner/administrator URL is rejected by runtime startup.
APP_DATABASE_ENABLED=false
DATABASE_URL=
# Used only by the explicit database probe/migration command, never the API.
DATABASE_DIRECT_URL=
# AUTH-02 remains opt-in; use only a host whose callback logging was verified.
APP_AUTH_ENABLED=false
APP_BROWSER_CONTEXT_ENABLED=false
APP_AUTH_CALLBACK_LOGGING_CONTROLLED=false
APP_AUTH_JWKS_BACKGROUND_REFRESH=true
APP_AUTH_DEMO_UI=false
APP_DATABASE_POOL_MAX_SIZE=2
# Secret manager or local-only values. Never use the direct DB URL in runtime.
APP_AUTH_VERIFIER_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
PUBLIC_ORIGIN=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=

# Internal service verification; provision private caller/key registries before enabling.
APP_INTERNAL_AUTH_ENABLED=false
APP_DELEGATION_ISSUER=enterprise-ai-platform

# FILE-01 remains disabled until private storage and worker are configured.
APP_FILES_ENABLED=false
APP_FILES_BUCKET=
APP_FILES_PARSER_IMAGE=
FILE_EXECUTOR_CREDENTIAL=

# KNOW-01 remains disabled until migration/provider/deployment prerequisites are ready.
APP_KNOWLEDGE_ENABLED=false
# BD-FE-01 requires auth, database and migration0019.
APP_ORGANIZATION_ENABLED=false
# KNOWLEDGE_EXECUTOR_CREDENTIAL is provisioned separately; never paste it in chat.

# CONV-01 is opt-in; no model execution is enabled by this flag.
APP_CONVERSATIONS_ENABLED=false

# POL-01 / trips catalog: final private integration, opt-in only. Requires auth,
# database, knowledge, internal verification, browser context and migration0021.
# Provision matching private recipient/signing/receiver key registries separately.
# No human receipt/claim binding producer is inferred from enabling this flag.
APP_REIMBURSEMENT_ENABLED=false
APP_REIMBURSEMENT_ORIGIN=
APP_REIMBURSEMENT_DISPATCHER_CREDENTIAL=
# PEM value via private environment/secret injection; never paste it in chat.
APP_REIMBURSEMENT_SIGNING_PRIVATE_KEY=
APP_REIMBURSEMENT_SIGNING_KID=current
APP_REIMBURSEMENT_SETTLEMENT_KEY_ID=reference-v1

# Explicit synthetic OpenRouter smoke only; ignored by API startup.
# Never put the real key in a tracked file. No AWS embeddings or paid fallback.
OPENROUTER_API_KEY=


# FILE-02: platform0023 + reference0005, private registries and ACT source required.
# JSON format is documented in docs/backend/receipt_pins.md; real keys stay private.
APP_RECEIPTS_ENABLED=false
APP_RECEIPT_SECURITY=

# DRAFT-01: platform0024, FILE-02 dependencies and source draft read endpoint.
# Preview does not issue consent, freeze a draft or submit a claim.
APP_DRAFTS_ENABLED=false

# ACT-01: platform0025, durable human consent/action/outbox; dispatch is FLOW-01.
APP_ACTIONS_ENABLED=false

# FLOW-01: explicit worker only; no automatic scheduler/worker startup.
APP_FLOW_ENABLED=false
APP_REIMBURSEMENT_RECOVERY_CREDENTIAL=
ACTION_EXECUTOR_CREDENTIAL=

# Scoped browser administration; requires auth, database, G13 and migration29.
ADMINISTRATION_ENABLED=false
