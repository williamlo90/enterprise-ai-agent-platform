# API foundation only. No database, identity, or model credentials are needed.
# Process environment overrides this file. Copy to .env locally if desired.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# BE-02 boundary defaults (bytes and seconds); no provider credentials.
APP_MAX_REQUEST_BODY_BYTES=1048576
APP_REQUEST_BODY_TIMEOUT_SECONDS=10
