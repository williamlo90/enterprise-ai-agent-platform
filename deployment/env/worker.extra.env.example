# Merge with platform config into a separate private worker env file.
# Never use a scheduler credential as an executor credential.
SCHEDULER_CREDENTIAL=REPLACE_REGISTERED_GLOBAL_SCHEDULER_CREDENTIAL
EXECUTORS_JSON=REPLACE_JSON_MAPPING_REGISTERED_WORKER_UUID_TO_43_CHAR_CREDENTIAL
# Operator explicitly enables paid inference and fictional APAC routing.
EAI_ENABLE_MODEL_EXECUTION=false
EAI_FICTIONAL_APAC_ENABLED=false
EAI_PARSER_IMAGE_URI=REPLACE_ECR_PARSER_URI_AT_SHA256_DIGEST
