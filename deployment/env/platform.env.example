# Private operator values only; never commit the filled file.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=REPLACE_SCOPED_PLATFORM_RUNTIME_URL_VERIFY_FULL
APP_DATABASE_ENABLED=true
APP_DATABASE_POOL_MAX_SIZE=2
APP_AUTH_ENABLED=true
APP_AUTH_CALLBACK_LOGGING_CONTROLLED=true
APP_BROWSER_CONTEXT_ENABLED=true
APP_AUTH_VERIFIER_KEY=REPLACE_FERNET_KEY
PUBLIC_ORIGIN=https://REPLACE_PUBLIC_HOST
OIDC_ISSUER=REPLACE_COGNITO_ISSUER
OIDC_CLIENT_ID=REPLACE_COGNITO_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_COGNITO_CLIENT_SECRET
OIDC_REDIRECT_URI=https://REPLACE_PUBLIC_HOST/api/v1/auth/callback
OIDC_AUTHORIZATION_ENDPOINT=REPLACE_COGNITO_AUTHORIZE_ENDPOINT
OIDC_TOKEN_ENDPOINT=REPLACE_COGNITO_TOKEN_ENDPOINT
OIDC_JWKS_URI=REPLACE_COGNITO_JWKS_ENDPOINT
APP_FILES_ENABLED=true
APP_FILES_BUCKET=REPLACE_EXISTING_PRIVATE_VERSIONED_BUCKET
APP_KNOWLEDGE_ENABLED=true
APP_CONVERSATIONS_ENABLED=true
APP_ORGANIZATION_ENABLED=true
APP_ADMINISTRATION_ENABLED=true
# Privacy remains disabled until owning physical facts/policy are enrolled.
APP_PRIVACY_ENABLED=false
APP_INTERNAL_AUTH_ENABLED=true
APP_REIMBURSEMENT_ENABLED=true
APP_REIMBURSEMENT_ORIGIN=https://reference-api.enterprise-ai.svc.cluster.local
APP_REIMBURSEMENT_DISPATCHER_CREDENTIAL=REPLACE_REGISTERED_43_CHAR_CREDENTIAL
APP_REIMBURSEMENT_SIGNING_PRIVATE_KEY=REPLACE_PEM_USE_DOTENV_QUOTED_MULTILINE
APP_REIMBURSEMENT_SIGNING_KID=current
APP_REIMBURSEMENT_SETTLEMENT_KEY_ID=reference-v1
APP_RECEIPTS_ENABLED=true
APP_RECEIPT_SECURITY=REPLACE_REGISTERED_JSON_TRUST_CONFIG
APP_DRAFTS_ENABLED=true
APP_ACTIONS_ENABLED=true
APP_FLOW_ENABLED=true
APP_REIMBURSEMENT_RECOVERY_CREDENTIAL=REPLACE_DISTINCT_43_CHAR_RECOVERY_CREDENTIAL
EAI_INTERNAL_CA_FILE=/etc/eai/ca/ca.crt
EAI_JOURNAL_ENABLED=true
EAI_JOURNAL_WRITER_ARN=REPLACE_PLATFORM_WRITER_ARN
EAI_JOURNAL_ID=REPLACE_JOURNAL_ID
