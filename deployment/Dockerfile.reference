FROM ghcr.io/astral-sh/uv:0.11.26 AS uv
FROM python:3.13-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app/reference_service
COPY reference_service/pyproject.toml reference_service/uv.lock reference_service/README.md ./
COPY reference_service/src ./src
RUN uv sync --frozen --no-dev --no-editable
ENV PATH="/app/reference_service/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65532:65532
EXPOSE 8010
CMD ["python","-m","reimbursement_service.main"]
