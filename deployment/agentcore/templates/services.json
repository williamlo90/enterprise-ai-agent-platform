{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Enterprise AI AgentCore Runtime, Gateway, Memory and private tools.",
  "Parameters": {
    "Prefix": {
      "Type": "String",
      "Default": "enterprise-ai-agent",
      "AllowedPattern": "[a-z][a-z0-9-]{2,35}"
    },
    "RuntimeName": {
      "Type": "String",
      "Default": "enterprise_ai_agent",
      "AllowedPattern": "[A-Za-z][A-Za-z0-9_]{0,47}"
    },
    "RuntimeImageUri": {
      "Type": "String",
      "AllowedPattern": ".+@sha256:[a-f0-9]{64}"
    },
    "ToolsImageUri": {
      "Type": "String",
      "AllowedPattern": ".+@sha256:[a-f0-9]{64}"
    },
    "RuntimeSecretArn": {
      "Type": "String"
    },
    "ToolsSecretArn": {
      "Type": "String"
    },
    "ModelResourceArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact APAC Nova Pro profile and destination model ARNs plus Singapore Cohere embedding ARN."
    },
    "EnableModelExecution": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    }
  },
  "Resources": {
    "RuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock-agentcore.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "scoped-execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "RuntimeSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:InvokeGateway"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Gateway",
                      "GatewayArn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:CreateEvent",
                    "bedrock-agentcore:ListEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Memory",
                      "MemoryArn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": {
                    "Ref": "ModelResourceArns"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:GetAccountDataRetention",
                    "bedrock:GetModelInvocationLoggingConfiguration"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents",
                    "logs:DescribeLogStreams"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/${RuntimeName}*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:PutResourcePolicy"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/${RuntimeName}*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:DescribeLogGroups"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/${Prefix}-runtime"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "xray:PutTraceSegments",
                    "xray:PutTelemetryRecords",
                    "xray:GetSamplingRules",
                    "xray:GetSamplingTargets"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "bedrock-agentcore:GetWorkloadAccessTokenForUserId",
                    "bedrock-agentcore:InvokeAgentRuntimeForUser"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "ToolsRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "scoped-execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "ToolsSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${Prefix}-tools:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "xray:PutTraceSegments",
                    "xray:PutTelemetryRecords"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "GatewayRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock-agentcore.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "scoped-execution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:${Prefix}-tools"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Memory": {
      "Type": "AWS::BedrockAgentCore::Memory",
      "Properties": {
        "Name": {
          "Fn::Sub": "${RuntimeName}_memory"
        },
        "EventExpiryDuration": 7,
        "Description": "Tenant/actor/original-session execution context; no raw content."
      }
    },
    "Gateway": {
      "Type": "AWS::BedrockAgentCore::Gateway",
      "Properties": {
        "Name": {
          "Fn::Sub": "${Prefix}-gateway"
        },
        "AuthorizerType": "AWS_IAM",
        "ProtocolType": "MCP",
        "RoleArn": {
          "Fn::GetAtt": [
            "GatewayRole",
            "Arn"
          ]
        },
        "Description": "Policy retrieval and draft preparation tools."
      }
    },
    "ToolsLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Prefix}-tools"
        },
        "RetentionInDays": 7
      }
    },
    "Tools": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "ToolsLogGroup"
      ],
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${Prefix}-tools"
        },
        "PackageType": "Image",
        "Architectures": [
          "arm64"
        ],
        "Code": {
          "ImageUri": {
            "Ref": "ToolsImageUri"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "ToolsRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 30,
        "TracingConfig": {
          "Mode": "Active"
        },
        "Environment": {
          "Variables": {
            "EAI_AGENTCORE_SECRET_ARN": {
              "Ref": "ToolsSecretArn"
            },
            "EAI_AGENTCORE_GATEWAY_ID": {
              "Fn::GetAtt": [
                "Gateway",
                "GatewayIdentifier"
              ]
            }
          }
        }
      }
    },
    "Runtime": {
      "Type": "AWS::BedrockAgentCore::Runtime",
      "Properties": {
        "AgentRuntimeName": {
          "Ref": "RuntimeName"
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "RuntimeRole",
            "Arn"
          ]
        },
        "AgentRuntimeArtifact": {
          "ContainerConfiguration": {
            "ContainerUri": {
              "Ref": "RuntimeImageUri"
            }
          }
        },
        "NetworkConfiguration": {
          "NetworkMode": "PUBLIC"
        },
        "ProtocolConfiguration": "HTTP",
        "LifecycleConfiguration": {
          "IdleRuntimeSessionTimeout": 60,
          "MaxLifetime": 900
        },
        "EnvironmentVariables": {
          "AWS_REGION": {
            "Ref": "AWS::Region"
          },
          "EAI_AGENTCORE_SECRET_ARN": {
            "Ref": "RuntimeSecretArn"
          },
          "EAI_AGENTCORE_GATEWAY_URL": {
            "Fn::GetAtt": [
              "Gateway",
              "GatewayUrl"
            ]
          },
          "EAI_AGENTCORE_MEMORY_ID": {
            "Fn::GetAtt": [
              "Memory",
              "MemoryId"
            ]
          },
          "EAI_ENABLE_MODEL_EXECUTION": {
            "Ref": "EnableModelExecution"
          },
          "EAI_FICTIONAL_APAC_ENABLED": {
            "Ref": "EnableModelExecution"
          },
          "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT": "false",
          "TRACELOOP_TRACE_CONTENT": "false"
        }
      }
    },
    "RuntimeLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/bedrock-agentcore/runtimes/${Runtime.AgentRuntimeId}-DEFAULT"
        },
        "RetentionInDays": 7
      }
    },
    "ToolsTarget": {
      "Type": "AWS::BedrockAgentCore::GatewayTarget",
      "Properties": {
        "GatewayIdentifier": {
          "Fn::GetAtt": [
            "Gateway",
            "GatewayIdentifier"
          ]
        },
        "Name": "platform",
        "CredentialProviderConfigurations": [
          {
            "CredentialProviderType": "GATEWAY_IAM_ROLE"
          }
        ],
        "TargetConfiguration": {
          "Mcp": {
            "Lambda": {
              "LambdaArn": {
                "Fn::GetAtt": [
                  "Tools",
                  "Arn"
                ]
              },
              "ToolSchema": {
                "InlinePayload": [
                  {
                    "Name": "search_policy",
                    "Description": "Retrieve accessible policy passages for the admitted question.",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "binding": {
                          "Type": "object",
                          "Properties": {
                            "id": {
                              "Type": "string"
                            },
                            "tenant_id": {
                              "Type": "string"
                            },
                            "worker_id": {
                              "Type": "string"
                            },
                            "generation": {
                              "Type": "integer"
                            },
                            "epoch": {
                              "Type": "integer"
                            }
                          },
                          "Required": [
                            "id",
                            "tenant_id",
                            "worker_id",
                            "generation",
                            "epoch"
                          ]
                        },
                        "arguments": {
                          "Type": "object",
                          "Properties": {
                            "operation": {
                              "Type": "string"
                            },
                            "query": {
                              "Type": "string"
                            },
                            "vector": {
                              "Type": "array",
                              "Items": {
                                "Type": "number"
                              }
                            },
                            "mode": {
                              "Type": "string"
                            }
                          },
                          "Required": [
                            "operation",
                            "query",
                            "vector",
                            "mode"
                          ]
                        }
                      },
                      "Required": [
                        "binding",
                        "arguments"
                      ]
                    }
                  },
                  {
                    "Name": "get_policy_version",
                    "Description": "Recheck current access to the exact retrieved policy versions.",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "binding": {
                          "Type": "object",
                          "Properties": {
                            "id": {
                              "Type": "string"
                            },
                            "tenant_id": {
                              "Type": "string"
                            },
                            "worker_id": {
                              "Type": "string"
                            },
                            "generation": {
                              "Type": "integer"
                            },
                            "epoch": {
                              "Type": "integer"
                            }
                          },
                          "Required": [
                            "id",
                            "tenant_id",
                            "worker_id",
                            "generation",
                            "epoch"
                          ]
                        },
                        "arguments": {
                          "Type": "object",
                          "Properties": {
                            "operation": {
                              "Type": "string"
                            },
                            "items": {
                              "Type": "array",
                              "Items": {
                                "Type": "object"
                              }
                            }
                          },
                          "Required": [
                            "operation",
                            "items"
                          ]
                        }
                      },
                      "Required": [
                        "binding",
                        "arguments"
                      ]
                    }
                  },
                  {
                    "Name": "create_reimbursement_draft",
                    "Description": "Prepare the admitted editable draft and preview; human confirmation stays in the application.",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "binding": {
                          "Type": "object",
                          "Properties": {
                            "id": {
                              "Type": "string"
                            },
                            "tenant_id": {
                              "Type": "string"
                            },
                            "worker_id": {
                              "Type": "string"
                            },
                            "generation": {
                              "Type": "integer"
                            },
                            "epoch": {
                              "Type": "integer"
                            }
                          },
                          "Required": [
                            "id",
                            "tenant_id",
                            "worker_id",
                            "generation",
                            "epoch"
                          ]
                        },
                        "arguments": {
                          "Type": "object",
                          "Properties": {
                            "operation": {
                              "Type": "string"
                            },
                            "content": {
                              "Type": "object"
                            }
                          },
                          "Required": [
                            "operation"
                          ]
                        }
                      },
                      "Required": [
                        "binding",
                        "arguments"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "RuntimeArn": {
      "Value": {
        "Fn::GetAtt": [
          "Runtime",
          "AgentRuntimeArn"
        ]
      }
    },
    "GatewayUrl": {
      "Value": {
        "Fn::GetAtt": [
          "Gateway",
          "GatewayUrl"
        ]
      }
    },
    "MemoryId": {
      "Value": {
        "Fn::GetAtt": [
          "Memory",
          "MemoryId"
        ]
      }
    },
    "RuntimeRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "RuntimeRole",
          "Arn"
        ]
      }
    },
    "WorkerInvokeResource": {
      "Value": {
        "Fn::GetAtt": [
          "Runtime",
          "AgentRuntimeArn"
        ]
      }
    }
  }
}
